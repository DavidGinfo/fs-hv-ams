if (${LINKER_SCRIPT_NAME} MATCHES "STM32G4")
    message(STATUS "Detected a STM32G4-family controller")
    include("${CMAKE_CURRENT_LIST_DIR}/stm32g4.cmake")
elseif (${LINKER_SCRIPT_NAME} MATCHES "STM32F4")
    message(STATUS "Detected a STM32F4-family controller")
    include("${CMAKE_CURRENT_LIST_DIR}/stm32f4.cmake")
elseif (${LINKER_SCRIPT_NAME} MATCHES "STM32H7")
    message(STATUS "Detected a STM32H7-family controller")
    include("${CMAKE_CURRENT_LIST_DIR}/stm32h7.cmake")
else ()
    message(FATAL_ERROR "Unknown STM32 family")
endif ()

list(APPEND mcu_families "STM32")
add_global_definitions(MCU_FAMILY_STM32=1)
